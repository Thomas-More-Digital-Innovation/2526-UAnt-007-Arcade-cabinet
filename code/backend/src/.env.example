UPLOADS_DIRECTORY=uploads # Don't forget to add this to gitignore
LOG_LEVEL=WARNING # DEBUG, INFO, WARNING, ERROR, CRITICAL
DB_LOG_LEVEL=ERROR # DEBUG, INFO, WARNING, ERROR, CRITICAL

UPLOADS_BACKEND=s3
UPLOADS_REMOTE_ROOT=s3://<bucket>/<optional-prefix>
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>

GITHUB_REPO_URL=https://api.github.com/repos/<owner>/<repo>/dispatches
GITHUB_TOKEN=<your-github-token>

API_KEY=